# PocketBase Configuration
# URL de tu instancia de PocketBase
POCKETBASE_URL=https://zeus-basedatos.fly.dev

# Credenciales de administrador de PocketBase
# IMPORTANTE: Reemplaza con tus credenciales reales
POCKETBASE_ADMIN_EMAIL=admin@tu-dominio.com
POCKETBASE_ADMIN_PASSWORD=tu_contraseña_secreta

# OpenAI API Key (opcional - para modelos GPT)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Deepseek API Key (opcional - para modelos Deepseek)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# LM Studio (Modelo Local)
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_MODEL=your-model-name

# Ollama Cloud (API en la nube con autenticación Bearer)
# Ejemplo: https://ollama.com/api/generate o tu proxy personal
OLLAMA_CLOUD_URL=https://ollama.com/api/chat
OLLAMA_CLOUD_API_KEY=tu-api-key-aqui

# NOTAS:
# 1. Copia este archivo como .env.local y reemplaza los valores
# 2. Las credenciales de admin son necesarias para que el historial funcione correctamente
# 3. Sin estas credenciales, el historial mostrará solo datos de ejemplo
# 4. Puedes obtener las credenciales desde tu panel de PocketBase > Settings > API Keys
# 5. Para usar modelo local con LM Studio, configura LM_STUDIO_URL y LM_STUDIO_MODEL
# 6. Para Ollama Cloud introduce tu API Key y la URL del endpoint /api/generate
