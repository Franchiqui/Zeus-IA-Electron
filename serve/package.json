{
  "name": "nextjs-preview-server",
  "version": "1.0.0",
  "description": "Servidor de vista previa para aplicaciones Next.js",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "node build-exe.js",
    "build:installer": "makensis installer.nsi"
  },
  "pkg": {
    "scripts": [
      "server.js"
    ],
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "preview-server.exe",
    "options": [
      "--compress",
      "GZip"
    ]
  },
  "build": {
    "win": {
      "icon": "public/installer-icon.ico"
    }
  },
  "_comment_pkg_warnings": "Los warnings de bytecode son normales y no críticos. Algunos módulos (como ansi-styles, string-width, etc.) no se pueden convertir a bytecode pero funcionan correctamente en tiempo de ejecución.",
  "dependencies": {
    "archiver": "^7.0.1",
    "child_process": "^1.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^4.21.2",
    "form-data": "^4.0.0",
    "fs-extra": "^11.1.1",
    "http-proxy-middleware": "^3.0.5",
    "multer": "^1.4.5-lts.1",
    "path": "^0.12.7",
    "pocketbase": "^0.22.1",
    "uuid": "^9.0.0",
    "ws": "^8.18.3",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "pkg": "^5.8.1"
  },
  "keywords": [
    "nextjs",
    "preview",
    "server",
    "zip",
    "deployment"
  ],
  "author": "Preview Server",
  "license": "MIT"
}