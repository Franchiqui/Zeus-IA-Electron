{
  "name": "zeus-ia",
  "version": "1.0.0",
  "description": "Zeus IA - An intelligent desktop assistant application",
  "author": "Zeus IA",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 8741",
    "build": "next build",
    "postinstall": "npx prisma generate",
    "start": "next start -p 8741",
    "lint": "next lint",
    "electron": "electron .",
    "electron:dev": "set NODE_ENV=development && electron .",
    "electron:prod": "set NODE_ENV=production && electron .",
    "electron:build": "electron-builder",
    "electron:build:win": "electron-builder --win nsis",
    "electron:build:installer": "electron-builder --win nsis --x64",
    "electron:build:mac": "electron-builder --mac",
    "electron:build:linux": "electron-builder --linux",
    "build:api-rae": "npm --prefix api/api-rae run build",
    "package": "npm run build && npm run build:api-rae && npm run electron:build"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/state": "^6.5.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.9",
    "@daypicker/react": "^10.0.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@iarna/toml": "^2.2.5",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.100.6",
    "@types/node": "^25.6.0",
    "@uiw/react-codemirror": "^4.25.4",
    "archiver": "^7.0.1",
    "axios": "^1.15.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "concurrently": "^10.0.3",
    "cssnano": "^7.1.7",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "electron-is-dev": "^3.0.1",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.38.0",
    "input-otp": "^1.2.4",
    "js-yaml": "^4.3.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.14.0",
    "monaco-editor-webpack-plugin": "^7.1.1",
    "next": "^16.2.7",
    "next-auth": "^4.24.14",
    "next-themes": "^0.4.6",
    "ollama": "^0.6.3",
    "openai": "^6.35.0",
    "png-to-ico": "^3.0.1",
    "pocketbase": "^0.26.8",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.74.0",
    "react-hot-toast": "^2.6.0",
    "react-resizable-panels": "^4.11.1",
    "recharts": "^3.8.1",
    "sonner": "^1.5.0",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.3",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "autoprefixer": "^10.5.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-config-next": "^16.2.4",
    "postcss": "^8.5.12",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.zeusia.desktop",
    "productName": "Zeus IA",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}",
      "!**/node_modules/nodemon/**",
      ".next/**",
      ".next/standalone/**",
      ".next/static/**",
      "public/**",
      "api/**",
      "terminal-server/**"
    ],
    "extraResources": [
      {
        "from": "pocket-base-zeus",
        "to": "pocket-base-zeus",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "PB_Datos",
        "to": "PB_Datos",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".",
        "to": "app",
        "filter": [
          "**/*",
          "!node_modules",
          "!dist",
          "!build",
          "!.git",
          "!.vscode"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/prisma/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zeus IA",
      "installerIcon": "public/LOGO_ZEUS-ico.ico",
      "uninstallerIcon": "public/LOGO_ZEUS-ico.ico",
      "installerHeaderIcon": "public/LOGO_ZEUS-ico.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "include": "build/installer.nsh",
      "customNsisBinary": {
        "url": "https://github.com/SoundSafari/NSISBI-ElectronBuilder/releases/download/1.0.0/nsisbi-electronbuilder-3.10.3.7z",
        "checksum": "374cfc092fd1bd1898472df627549ecc165b0d6ba88e82deba085673aec95336"
      },
      "warningsAsErrors": false
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png",
      "category": "Development"
    }
  }
}
